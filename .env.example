APP_NAME="Pradipta Portfolio"
APP_ENV=production
# Generate fresh 32-char production key via: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

VIEW_COMPILED_PATH=/tmp/storage/framework/views
APP_STORAGE_PATH=/tmp/storage

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Supabase PostgreSQL (Port 6543 = PgBouncer Transaction Pooler)
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require
DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# Serverless platforms cannot run persistent background workers, so sync is recommended
QUEUE_CONNECTION=sync

# Supabase S3-compatible Storage
FILESYSTEM_DISK=supabase
SUPABASE_PROJECT_REF=your-project-ref
# S3 Access Keys from: Supabase Dashboard > Settings > Storage > S3 Access Keys
SUPABASE_STORAGE_KEY=your-supabase-storage-key
SUPABASE_STORAGE_SECRET=your-supabase-storage-secret
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_STORAGE_URL=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_PATH_STYLE_ENDPOINT=true
# Bucket MUST be set to Public in Supabase Storage Dashboard
SUPABASE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public/resumes

# Optional secret to protect /api/keepalive ping endpoint
CRON_SECRET=


